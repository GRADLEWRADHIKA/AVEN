# Copy to .env for local development without Docker. Never commit .env.
ENV=development
DATABASE_URL=postgresql+psycopg://aven:aven@localhost:5432/aven
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_MINUTES=60
ALLOW_ORG_SIGNUP=true
CORS_ORIGINS=http://localhost:3000
